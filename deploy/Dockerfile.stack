# astroctl-stack — the stacking-server half of the M0-T08 two-node harness.
#
# Build from the repository root:  docker build -f deploy/Dockerfile.stack -t astroctl-stack:dev .
# Normally you want scripts/dev-up.sh, which builds both images and starts the pair.
#
# This is a test and development harness, not a deployment artefact (M0-T08 scope). The real
# stacking server is a Ryzen 9 with an RTX 4090 and a CUDA runtime; nothing here pretends to
# stand in for that. What this image is for is the half of the topology that has to be *reachable
# over a network boundary* for the other half to be worth testing.
#
# Deliberate decisions — the ones this file does not share with Dockerfile.field:
#
#   * `workers/` ships here and only here (ADD §5.6 rule 6). The field binary must build and run
#     with no GPU or ML runtime and no worker process management; packaging the workers with it
#     would make that rule unverifiable at the only place it can be checked, which is the image.
#
#   * python3 **and workers/requirements.txt** are installed. `workers.python_interpreter` has to
#     name a real interpreter or M1-T13's first spawn becomes a puzzle. M1-T13 stopped at a bare
#     interpreter on purpose — the supervision half of T-IPC-1 (handshake, ping, version refusal,
#     restart) runs without a single dependency, and the worker reports a missing one as a
#     structured error rather than failing to start. That was right then and is wrong now: M1-T14
#     put the preview job behind the same worker, and T-E2E-1 asserts the preview comes back
#     through the proxy, so numpy and Pillow became load-bearing for the milestone's own exit
#     criterion. A harness image without them fails M1-T16 with `the worker environment is
#     incomplete`, which is the worker being exactly as honest as it was built to be about an
#     image that is not.
#
#     `--break-system-packages` into the system interpreter, rather than the venv the example
#     config names: the harness config names `/usr/bin/python3`, and a venv would put a second
#     path in a file whose whole job is to differ from the example in as few places as possible.
#     PEP 668 marks Debian's interpreter externally managed and this is the standard override for
#     a container, where there is no system Python to break. The CUDA and ML stack stays out —
#     it belongs to ml_worker.py, which nothing in M1 spawns.
#
#   * No PWA stage. The operator's browser never loads anything from this node — it talks to the
#     field node and reaches this one through /stack/* (ADR-07).
#
# Everything above the "diverges" line in stage 2 is byte-identical to Dockerfile.field so the
# two images share the dependency layer. Keep it that way, or building the pair compiles the
# third-party graph twice.

# --------------------------------------------------------------------------------------------
# 1. The binary.
# --------------------------------------------------------------------------------------------
FROM rust:1.97.1-slim-bookworm AS build
WORKDIR /src

# --- dependency layer ---
# Manifests and a stub source tree, so this layer compiles every third-party crate and nothing of
# ours. It stays cached until Cargo.lock or a Cargo.toml changes; without it, a one-line edit to
# any .rs file recompiles the entire dependency graph and the E2E job becomes the slowest thing in
# CI, which is how E2E jobs get switched off.
#
# The 14 manifests are listed one by one because Docker's COPY cannot preserve a directory shape
# through a glob. A new workspace crate that nobody adds here is not silent: if a binary depends on
# it, cargo fails at once on the missing path dependency; if nothing does, the only cost is that
# its dependencies land in the slow layer instead of this one.
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/astroctl-core/Cargo.toml crates/astroctl-core/
COPY crates/astroctl-hal/Cargo.toml crates/astroctl-hal/
COPY crates/astroctl-drivers/Cargo.toml crates/astroctl-drivers/
COPY crates/astroctl-safety/Cargo.toml crates/astroctl-safety/
COPY crates/astroctl-session/Cargo.toml crates/astroctl-session/
COPY crates/astroctl-pipeline/Cargo.toml crates/astroctl-pipeline/
COPY crates/astroctl-solver/Cargo.toml crates/astroctl-solver/
COPY crates/astroctl-planning/Cargo.toml crates/astroctl-planning/
COPY crates/astroctl-guiding/Cargo.toml crates/astroctl-guiding/
COPY crates/astroctl-transfer/Cargo.toml crates/astroctl-transfer/
COPY crates/astroctl-llm/Cargo.toml crates/astroctl-llm/
COPY crates/astroctl-ipc/Cargo.toml crates/astroctl-ipc/
COPY crates/astroctl-field/Cargo.toml crates/astroctl-field/
COPY crates/astroctl-stack/Cargo.toml crates/astroctl-stack/
# The stub tree has to satisfy *every* target cargo can see, not just `src/lib.rs` and
# `src/main.rs`. A crate that declares `[[bin]] path = "testdata/…"` — which M1-T07 and M1-T11
# both do, for the harnesses their durability tests SIGKILL — makes cargo fail at target
# resolution before it compiles a line, and the error names a path rather than a cause. So the
# `[[bin]]` paths are read back out of the manifests that were just copied in, rather than listed
# here: a list would be a third place to remember, after the manifest and the test that spawns it.
RUN set -eu; \
    for dir in crates/*/; do \
        mkdir -p "$dir/src"; \
        printf '//! placeholder for the dependency layer\n' >"$dir/src/lib.rs"; \
    done; \
    for bin in field stack; do \
        printf '//! placeholder for the dependency layer\nfn main() {}\n' \
            >"crates/astroctl-$bin/src/main.rs"; \
    done; \
    awk '/^\[\[bin\]\]/ { section = 1; next } \
         /^\[/ { section = 0 } \
         section && /^[[:space:]]*path[[:space:]]*=/ { \
             gsub(/^[^"]*"|"[^"]*$/, ""); print FILENAME "|" $0 }' \
        crates/*/Cargo.toml \
    | while IFS='|' read -r manifest declared; do \
        stub="$(dirname "$manifest")/$declared"; \
        mkdir -p "$(dirname "$stub")"; \
        printf '//! placeholder for the dependency layer\nfn main() {}\n' >"$stub"; \
    done; \
    cargo build --release --workspace --locked

# --- the real sources ---
COPY crates/ crates/
# cargo decides what to rebuild by mtime, and COPY preserves the mtimes from the build context —
# which are older than the stub build above whenever the checkout is. Without this the stubs would
# be considered current and the image would ship a binary that does nothing.
RUN find crates -name '*.rs' -exec touch {} +

# ---------------- diverges from Dockerfile.field here ----------------
RUN cargo build --release --locked -p astroctl-stack

# --------------------------------------------------------------------------------------------
# 2. What actually runs.
# --------------------------------------------------------------------------------------------
FROM debian:bookworm-slim AS runtime

# curl, iproute2 and netcat are the harness, not the product — see Dockerfile.field for what each
# one is for. python3 is this image's own: it is what `workers.python_interpreter` names.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        iproute2 \
        netcat-openbsd \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

# The workers' dependencies, from the file that declares them rather than from a list repeated
# here — the version constraints are argued in workers/requirements.txt and a second copy would be
# free to drift from the first. Copied alone, before the rest of `workers/`, so editing a worker
# does not re-resolve two wheels.
COPY workers/requirements.txt /tmp/requirements.txt
RUN pip install --break-system-packages --no-cache-dir -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

RUN useradd --system --no-create-home --user-group --uid 10001 astroctl

# The stacking server's copy of a session is the authoritative one (IPP-09, REL-13), so this is
# the volume that must survive a restart. Ownership is set here because a fresh named volume
# inherits what the image has at the mount point.
RUN install -d -o astroctl -g astroctl \
        /data/astro \
        /data/astro/sessions \
        /data/astro/logs \
        /data/astro/stacks \
        /data/astro/calibration \
        /data/astro/ml_models \
        /data/astro/references

WORKDIR /opt/astroctl
COPY --from=build /src/target/release/astroctl-stack /usr/local/bin/astroctl-stack
# ADD §5.6 rule 6: the stacking server is the only place the Python workers are packaged. The
# config names them by a path relative to the working directory, which is why WORKDIR is above.
COPY workers/ /opt/astroctl/workers/
COPY deploy/config/stacking-server.yaml /etc/astroctl/stacking-server.yaml

ENV ASTROCTL_STACK_CONFIG=/etc/astroctl/stacking-server.yaml

# Documentation only, and compose deliberately does not publish it: nothing but the field node has
# any business talking to this port (ADD §5.5).
EXPOSE 8471

USER astroctl
# No shell wrapper: PID 1 is the binary, so SIGTERM from `docker stop` reaches the graceful
# shutdown path instead of being absorbed by a shell that ignores it.
ENTRYPOINT ["/usr/local/bin/astroctl-stack"]
